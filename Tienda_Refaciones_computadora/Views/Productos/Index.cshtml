@model IEnumerable<Producto>

@{
    ViewData["Title"] = "Productos";
    var totalPiezas = Model.Sum(p => p.Stock);
    var valorTotal = Model.Sum(p => p.Precio * p.Stock);
}

<h1>Productos</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<a asp-action="Create" class="btn btn-success mb-3">Nuevo producto</a>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Buscar por nombre o marca" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron productos.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Marca</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Subtotal</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Marca</td>
                    <td>@item.Categoria?.Nombre</td>
                    <td>$@item.Precio.ToString("N2")</td>
                    <td>@item.Stock</td>
                    <td>$@((item.Precio * item.Stock).ToString("N2"))</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalle</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="card mt-3" style="max-width: 420px;">
        <div class="card-body">
            <h5 class="card-title">Resumen del inventario</h5>
            <p class="mb-1">Productos en la lista: <strong>@Model.Count()</strong></p>
            <p class="mb-1">Total de piezas en stock: <strong>@totalPiezas</strong></p>
            <p class="mb-0">Valor total del inventario: <strong>$@valorTotal.ToString("N2")</strong></p>
        </div>
    </div>
}