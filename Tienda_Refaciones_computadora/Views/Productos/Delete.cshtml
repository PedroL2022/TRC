@model Producto

@{
    ViewData["Title"] = "Eliminar producto";
}

<h1>Eliminar producto</h1>

<div class="alert alert-danger">¿Seguro que deseas eliminar este producto?</div>

<div class="card mb-3" style="max-width: 520px;">
    <div class="card-body">
        <h4 class="card-title">@Model.Nombre</h4>
        <dl class="row mb-0">
            <dt class="col-sm-4">Marca</dt>
            <dd class="col-sm-8">@Model.Marca</dd>

            <dt class="col-sm-4">Categoría</dt>
            <dd class="col-sm-8">@Model.Categoria?.Nombre</dd>

            <dt class="col-sm-4">Precio</dt>
            <dd class="col-sm-8">$@Model.Precio.ToString("N2")</dd>

            <dt class="col-sm-4">Stock</dt>
            <dd class="col-sm-8">@Model.Stock</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>