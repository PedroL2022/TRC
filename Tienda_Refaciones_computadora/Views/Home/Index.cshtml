@{
    ViewData["Title"] = "Inicio";
}

<style>
    .portada {
        min-height: 70vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
    }

    .portada h1 {
        font-size: 3.5rem;
        font-weight: 700;
        color: #1b3a5c;
    }

    .portada .linea {
        width: 120px;
        height: 4px;
        background: #1b3a5c;
        border-radius: 2px;
        margin: 1.5rem auto;
    }

    .portada .nombre {
        font-size: 1.8rem;
        font-weight: 600;
    }

    .portada .anio {
        color: #6c757d;
        letter-spacing: 2px;
    }

    @@media (max-width: 768px) {
        .portada h1 { font-size: 2.3rem; }
    }
</style>

<section class="portada">
    <h1>Tienda de Refacciones</h1>
    <div class="linea"></div>
    <div class="nombre">Pedro Lantigua</div>
    <div class="anio mb-4">2025 - 2022</div>
    <a asp-controller="Productos" asp-action="Index" class="btn btn-primary btn-lg">Ver productos</a>
</section>